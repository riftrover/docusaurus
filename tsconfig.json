{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["@docusaurus/module-type-aliases"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "src"]
}
